{
  "name": "afclip-prototypes",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AFClip project engine and Windows editing prototype",
  "scripts": {
    "library": "node src/library/cli.ts",
    "library:gui": "node src/library/cli.ts gui",
    "library:dev": "node src/library/cli.ts gui --dev",
    "afclip": "node src/cli.ts",
    "start": "node src/gui/launch.cjs",
    "dev": "node src/gui/launch.cjs --dev",
    "edit:example": "node examples/vellum-first-edit/build.mjs",
    "bench:windows": "node benchmarks/windows/run.cjs",
    "bench:solutions": "node benchmarks/windows/solutions.cjs",
    "bench:gpu": "node benchmarks/windows/gpu.cjs"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0"
  },
  "optionalDependencies": {
    "@ffprobe-installer/darwin-arm64": "5.0.1"
  },
  "dependencies": {
    "parse5": "^8.0.0"
  }
}
