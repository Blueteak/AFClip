{
  "name": "afclip-prototypes",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "AFClip project engine and Windows editing prototype",
  "scripts": {
    "library": "node src/library/cli.ts",
    "library:gui": "node src/library/cli.ts gui",
    "library:dev": "node src/library/cli.ts gui --dev",
    "afclip": "node src/cli.ts",
    "start": "node src/gui/launch.cjs",
    "dev": "node src/gui/launch.cjs --dev",
    "dev:install": "node scripts/install-dev-launcher.cjs",
    "bench:windows": "node benchmarks/windows/run.cjs",
    "bench:solutions": "node benchmarks/windows/solutions.cjs",
    "bench:gpu": "node benchmarks/windows/gpu.cjs",
    "dist:win": "node scripts/prepare-release.cjs && electron-builder --config electron-builder.cjs --win --x64 --publish never",
    "pack:win": "node scripts/prepare-release.cjs && electron-builder --config electron-builder.cjs --win --x64 --dir --publish never",
    "dist:mac": "node scripts/prepare-release.cjs && electron-builder --config electron-builder.cjs --mac --arm64 --publish never",
    "pack:mac": "node scripts/prepare-release.cjs && electron-builder --config electron-builder.cjs --mac --arm64 --dir --publish never"
  },
  "optionalDependencies": {
    "@ffprobe-installer/darwin-arm64": "5.0.1"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.303",
    "electron-updater": "6.8.11",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "markdown-it": "14.3.3",
    "parse5": "^8.0.0"
  },
  "bin": {
    "af-clip": "src/cli.ts",
    "af-lib": "src/library/cli.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "26.18.0"
  },
  "main": "src/desktop/main.cjs",
  "author": "AFClip",
  "homepage": "https://afclip.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Blueteak/AFClip.git"
  }
}
