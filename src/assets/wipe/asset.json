{
  "apiVersion": 1,
  "role": "transition",
  "name": "Diagonal glow wipe",
  "parameters": {
    "slant": {
      "type": "number",
      "default": 0.25,
      "min": -1,
      "max": 1
    },
    "glow": {
      "type": "number",
      "default": 12,
      "min": 0,
      "max": 80
    },
    "color": {
      "type": "color",
      "default": "#77e6ff"
    },
    "reverse": {
      "type": "boolean",
      "default": false
    },
    "pixelBand": {
      "type": "number",
      "default": 50,
      "min": 0,
      "max": 240
    }
  }
}
