{
  "apiVersion": 1,
  "role": "content",
  "name": "Word slam",
  "parameters": {
    "word": { "type": "text", "default": "EXPLORE" },
    "kicker": { "type": "text", "default": "" },
    "color": { "type": "color", "default": "#ffffff" },
    "accent": { "type": "color", "default": "#5ee8ff" },
    "align": { "type": "choice", "default": "center", "choices": ["left", "center", "right"] },
    "size": { "type": "number", "default": 230, "min": 40, "max": 500, "step": 1 }
  }
}
