{
  "apiVersion": 1,
  "role": "effect",
  "name": "Gilded reveal",
  "parameters": {
    "start": { "type": "number", "default": 0, "min": 0, "max": 60, "step": 0.05, "label": "Start (s)" },
    "duration": { "type": "number", "default": 1.1, "min": 0.05, "max": 10, "step": 0.05, "label": "Duration (s)" },
    "wipe": { "type": "boolean", "default": true },
    "angle": { "type": "number", "default": 18, "min": -60, "max": 60, "step": 1, "label": "Angle (deg)" },
    "blur": { "type": "number", "default": 10, "min": 0, "max": 40, "step": 1, "label": "Blur (px)" },
    "glintAt": { "type": "number", "default": 3, "min": 0, "max": 60, "step": 0.05, "label": "Glint (s)" },
    "glow": { "type": "color", "default": "#f6d48a" },
    "intensity": { "type": "number", "default": 1.4, "min": 0, "max": 3, "step": 0.05 }
  }
}
